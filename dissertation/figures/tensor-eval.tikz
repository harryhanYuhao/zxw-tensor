% Evaluating the tensor H = [[1,1],[1,-1]] in tensor-network notation:
% H is drawn as a node with two edges; labelling the two edges with the
% index values (i,j) evaluates the tensor. The four panels show
% H_00 = 1, H_01 = 1, H_10 = 1 and H_11 = -1.
% Self-contained: the colours are defined inside the picture, so this
% file can be \input anywhere.
\begin{tikzpicture}[>=Stealth, line join=round, line cap=round,
    tn/.style={circle, draw=tnoutline, line width=0.8mm, inner sep=0pt,
               minimum size=0.8cm, font=\large},
    wire/.style={line width=0.8mm, black},
    idx/.style={font=\normalsize}]
    \definecolor{tnorange}{RGB}{255,192,0}       % orange -- the tensor H
    \definecolor{tngreen}{RGB}{0,176,80}         % green  -- matrix M
    \definecolor{tnblue}{RGB}{68,114,196}        % blue   -- rank-three tensor T
    \definecolor{tnoutline}{RGB}{23,44,81}       % navy outline

    % --- H evaluated at (0,0) = 1 ---
    \draw[wire] (0,0) .. controls (-0.4,0.5) .. (-0.5,1.3);
    \draw[wire] (0,0) .. controls (0.4,0.5) .. (0.5,1.3);
    \node[tn, fill=tnorange, text=black] at (0,0) {$H$};
    \node[idx] at (-0.8,0.8) {$0$};
    \node[idx] at (0.8,0.8) {$0$};
    \node[idx] at (1.5,0.4) {$= 1,$};

    % --- H evaluated at (0,1) = 1 ---
    \draw[wire] (3.6,0) .. controls (3.2,0.5) .. (3.1,1.3);
    \draw[wire] (3.6,0) .. controls (4.0,0.5) .. (4.1,1.3);
    \node[tn, fill=tnorange, text=black] at (3.6,0) {$H$};
    \node[idx] at (2.8,0.8) {$0$};
    \node[idx] at (4.4,0.8) {$1$};
    \node[idx] at (5.1,0.4) {$= 2,$};

    % --- H evaluated at (1,0) = 1 ---
    \draw[wire] (7.2,0) .. controls (6.8,0.5) .. (6.7,1.3);
    \draw[wire] (7.2,0) .. controls (7.6,0.5) .. (7.7,1.3);
    \node[tn, fill=tnorange, text=black] at (7.2,0) {$H$};
    \node[idx] at (6.4,0.8) {$1$};
    \node[idx] at (8.0,0.8) {$0$};
    \node[idx] at (8.7,0.4) {$= 3,$};

    % --- H evaluated at (1,1) = -1 ---
    \draw[wire] (10.8,0) .. controls (10.4,0.5) .. (10.3,1.3);
    \draw[wire] (10.8,0) .. controls (11.2,0.5) .. (11.3,1.3);
    \node[tn, fill=tnorange, text=black] at (10.8,0) {$H$};
    \node[idx] at (10.0,0.8) {$1$};
    \node[idx] at (11.6,0.8) {$1$};
    \node[idx] at (12.3,0.4) {$= 4$};
\end{tikzpicture}
