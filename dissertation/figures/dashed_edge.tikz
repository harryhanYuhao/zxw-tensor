        \node [GREEN_DOT] (5) at (2.58333, 0) {};
        \node [YELLOW_BOX] (6) at (1.58333, 0) {};
    \end{pgfonlayer}
    \begin{pgfonlayer}{edgelayer}
        \draw[BLUE_DASHED_EDGE] (1) to (2);
        \draw[EDGE] (4) to (5);
    \end{pgfonlayer}
\end{tikzpicture}

\endgroup
